[Desktop Entry]
Type=Application
Name=Install Soldar
Comment=Install Soldar on this computer
Exec=python3 -c "import os, subprocess, sys; d = os.path.dirname(sys.argv[1]) if len(sys.argv) > 1 else os.getcwd(); subprocess.run(['x-terminal-emulator', '-e', 'bash', os.path.join(d, 'install.sh')])" %k
Icon=system-software-install
Terminal=false
Categories=Utility;
